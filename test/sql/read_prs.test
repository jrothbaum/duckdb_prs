# name: test/sql/read_prs.test
# description: test read_prs extension
# group: [read_prs]

# Before loading the extension, functions should not exist
statement error
SELECT * FROM read_sas7bdat('test/data/file1.sas7bdat');
----
Catalog Error

statement error
SELECT * FROM read_dta('test/data/stata7_117.dta');
----
Catalog Error

statement error
SELECT * FROM read_sav('test/data/simple_alltypes.sav');
----
Catalog Error

require read_prs

# SAS: row and column count
query I
SELECT count(*) FROM read_sas7bdat('test/data/file1.sas7bdat');
----
40

query I
SELECT count(*) FROM information_schema.columns WHERE table_name = 'file1.sas7bdat';
----
0

query II
SELECT * FROM read_sas7bdat('test/data/file1.sas7bdat') LIMIT 1;
----
115.22	3.69

# Stata: basic read
query III
SELECT * FROM read_dta('test/data/stata7_117.dta');
----
1	a	1.0

# SPSS: row count
query I
SELECT count(*) FROM read_sav('test/data/simple_alltypes.sav');
----
6
